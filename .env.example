# abuse.ch Auth-Key (OPSIYONEL). https://auth.abuse.ch adresinden ucretsiz alinir.
# Bos birakilirsa: ThreatFox herkese acik tam export'undan GERCEK IOC cekilir (anahtar gerekmez).
# Dolu ise: ThreatFox + MalwareBazaar canli API'leri kullanilir (en guncel veri).
ABUSECH_AUTH_KEY=

# Veri penceresi baslangici (YYYY-MM). Pipeline bu aydan bugune kadar ceker.
WINDOW_FROM=2024-07

# Mevcut snapshot'i (data/cti.db) yok sayip API'den yeniden cek (true/false).
REFRESH=false

# ransomware.live istekleri arasi minimum gecikme (ms). Rate limit icin.
THROTTLE_MS=800
